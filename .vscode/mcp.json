{
  "inputs": [
    {
      "type": "promptString",
      "id": "smithery-key",
      "description": "Smithery API Key",
      "password": true,
      "default": "f14cef5c-b856-454f-bf01-7cf75df918c5"
    },
    {
      "type": "promptString",
      "id": "smithery-profile",
      "description": "Smithery Profile",
      "default": "geographical-eagle-karTUD"
    }
  ],
  "servers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@smithery/cli@latest",
        "run",
        "@upstash/context7-mcp",
        "--key",
        "${input:smithery-key}"
      ]
    },
