{
  "app": {
    "name": "Network Management Platform",
    "version": "1.0.0",
    "environment": "production"
  },
  "api": {
    "baseUrl": "http://localhost:8000",
    "timeout": 30000,
    "retries": 3
  },
  "features": {
    "dashboard": true,
    "devices": true,
    "network": true,
    "metrics": true,
    "pxeBoot": true,
    "predictiveMaintenance": true,
    "chat": true,
    "settings": true
  },
  "monitoring": {
    "refreshInterval": 5000,
    "metricsRetention": 86400,
    "alertThresholds": {
      "cpu": 80,
      "memory": 85,
      "disk": 90,
      "gpu": 95
    }
  },
  "ui": {
    "theme": "dark",
    "sidebarCollapsed": false,
    "notificationsEnabled": true,
    "animations": true
  },
  "websocket": {
    "enabled": true,
    "reconnectInterval": 5000,
    "maxReconnectAttempts": 10
  }
}